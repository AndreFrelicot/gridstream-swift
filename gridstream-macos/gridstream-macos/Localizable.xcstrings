          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão encerrada"
          }
        }
      }
    },
    "Signing in": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio de sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Início de sessão"
          }
        }
      }
    },
    "Signs out every iPad and browser at once, for example after lending a device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la sesión en todos los iPad y navegadores a la vez, por ejemplo después de prestar un dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecte tous les iPad et navigateurs d’un coup, par exemple après avoir prêté un appareil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecta todos os iPads e navegadores de uma vez, por exemplo depois de emprestar um dispositivo."
          }
        }
      }
    },
    "Small frames the iPad shows while you drag along a video's timeline. They are made the first time they are needed and kept in the database.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogramas pequeños que el iPad muestra mientras arrastras por la línea de tiempo de un vídeo. Se crean la primera vez que hacen falta y se guardan en la base de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les petites images que l’iPad affiche quand vous faites glisser le doigt le long de la barre de lecture d’une vidéo. Elles sont créées la première fois qu’elles sont nécessaires et conservées dans la base de données."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequenos quadros que o iPad mostra enquanto você arrasta pela linha do tempo de um vídeo. Eles são criados na primeira vez que são necessários e guardados no banco de dados."
          }
        }
      }
    },
    "Source Folders": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas de origen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossiers sources"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas de origem"
          }
        }
      }
    },
    "Start Empty": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar vacía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartir de zéro"
          }
        },
        "pt-BR": {
