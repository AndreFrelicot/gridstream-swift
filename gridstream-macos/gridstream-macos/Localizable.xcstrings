    "Looks for videos that were added, changed or deleted since the last scan. GridStream also scans when it starts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca los vídeos que se han añadido, cambiado o eliminado desde el último análisis. GridStream también analiza al iniciarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche les vidéos ajoutées, modifiées ou supprimées depuis la dernière analyse. GridStream lance aussi une analyse à son ouverture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura vídeos adicionados, alterados ou apagados desde a última análise. O GridStream também faz uma análise ao ser aberto."
          }
        }
      }
    },
