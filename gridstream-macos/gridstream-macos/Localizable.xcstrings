            "value": "Começar vazio"
          }
        }
      }
    },
    "Start Server": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer le serveur"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar servidor"
          }
        }
      }
    },
    "Start Server and Stop Server control streaming. While the server is stopped, iPads and browsers cannot connect. It cannot be started or stopped during a scan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar servidor y Detener servidor controlan la transmisión. Mientras el servidor está detenido, los iPad y los navegadores no pueden conectarse. No se puede iniciar ni detener durante un análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer le serveur et Arrêter le serveur contrôlent la diffusion. Tant que le serveur est arrêté, les iPad et les navigateurs ne peuvent pas se connecter. Il ne peut être ni démarré ni arrêté pendant une analyse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar servidor e Parar servidor controlam a transmissão. Enquanto o servidor estiver parado, iPads e navegadores não podem se conectar. Ele não pode ser iniciado nem parado durante uma análise."
          }
        }
      }
    },
    "Start and stop": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar y detener"
          }
        },
        "fr": {
