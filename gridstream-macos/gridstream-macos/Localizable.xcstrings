    "Sign out every iPad and browser": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la sesión en todos los iPad y navegadores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter tous les iPad et navigateurs"
