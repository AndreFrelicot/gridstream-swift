      }
    },
    "Turn Off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar"
          }
        }
      }
    },
    "Turn On": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar"
          }
        }
      }
    },
    "Turn off to hide its videos from clients. Their tags, ratings and other data are kept.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívala para ocultar sus vídeos a los clientes. Sus etiquetas, valoraciones y otros datos se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez-le pour masquer ses vidéos aux clients. Leurs tags, notes et autres données sont conservés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para ocultar os vídeos dela dos clientes. As etiquetas, classificações e outros dados são mantidos."
          }
        }
      }
    },
    "Turn on": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar"
          }
        }
      }
    },
    "Turning a folder off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar una carpeta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver un dossier"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar uma pasta"
          }
        }
      }
    },
    "Type a PIN of 6 to 12 digits twice and click Save PIN. Changing the PIN signs out every device, which then asks for the new PIN.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe dos veces un PIN de 6 a 12 dígitos y haz clic en Guardar PIN. Cambiar el PIN cierra la sesión en todos los dispositivos, que piden entonces el PIN nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez deux fois un code PIN de 6 à 12 chiffres et cliquez sur Enregistrer le code PIN. Changer le code PIN déconnecte tous les appareils, qui demandent alors le nouveau code."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite duas vezes um PIN de 6 a 12 dígitos e clique em Salvar PIN. Alterar o PIN desconecta todos os dispositivos, que passam a pedir o novo PIN."
          }
        }
      }
    },
    "Unable to save PIN.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar el PIN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le code PIN."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o PIN."
          }
        }
      }
    },
    "Unavailable folders": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas no disponibles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossiers indisponibles"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas indisponíveis"
          }
        }
      }
    },
    "Unavailable — its videos are kept until the folder is reachable again": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible: sus vídeos se conservan hasta que la carpeta vuelva a estar accesible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible — ses vidéos sont conservées jusqu’à ce que le dossier soit de nouveau accessible"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponível — os vídeos são mantidos até que a pasta fique acessível novamente"
          }
        }
      }
    },
    "Update PIN": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar PIN"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour le code PIN"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizar PIN"
          }
        }
      }
    },
    "Use a single PIN to unlock web and iPad clients. Changing the PIN revokes existing sessions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un único PIN para desbloquear los clientes web y de iPad. Cambiar el PIN revoca las sesiones existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul code PIN déverrouille les clients web et iPad. Changer le code PIN révoque les sessions existantes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um único PIN para desbloquear os clientes web e de iPad. Alterar o PIN revoga as sessões existentes."
          }
        }
      }
    },
    "Using GridStream from a browser.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar GridStream desde un navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser GridStream depuis un navigateur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar o GridStream em um navegador."
          }
        }
      }
    },
    "Videos": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidéos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos"
          }
        }
      }
    },
    "Videos Processed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos procesados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidéos traitées"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos processados"
          }
        }
      }
    },
    "Videos Served": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos servidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidéos servies"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos servidos"
          }
        }
      }
    },
    "Videos is the number of videos in the catalog, Folders the number of folders turned on, and PIN tells whether clients need a PIN to connect.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos es el número de vídeos del catálogo, Carpetas el número de carpetas activadas y PIN indica si los clientes necesitan un PIN para conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidéos indique le nombre de vidéos du catalogue, Dossiers le nombre de dossiers activés, et Code PIN si les clients ont besoin d’un code PIN pour se connecter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos é o número de vídeos no catálogo, Pastas o número de pastas ativadas e PIN indica se os clientes precisam de um PIN para se conectar."
          }
        }
      }
    },
    "Videos whose files are no longer found on disk are kept, in case the file comes back. Purge… deletes them and all their data for good.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos cuyos archivos ya no están en el disco se conservan por si el archivo vuelve. Purgar… los elimina definitivamente con todos sus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos dont les fichiers sont introuvables sur le disque sont conservées, au cas où le fichier reviendrait. Purger… les supprime définitivement avec toutes leurs données."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vídeos cujos arquivos não estão mais no disco são mantidos, caso o arquivo volte. Limpar… apaga esses vídeos e todos os dados deles para sempre."
          }
        }
      }
    },
    "Waiting…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando…"
          }
        }
      }
    },
    "Web": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Web"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Web"
          }
        }
      }
    },
    "Web Browser": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegador web"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigateur web"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegador"
          }
        }
      }
    },
    "Web Interface": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfaz web"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface web"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface web"
          }
        }
      }
    },
    "What GridStream Server does": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué hace GridStream Server"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que fait GridStream Server"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o GridStream Server faz"
          }
        }
      }
    },
    "When a PIN is required, the browser asks for it once and remembers it for the session duration set in Security.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se requiere un PIN, el navegador lo pide una vez y lo recuerda durante la duración de sesión definida en Seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’un code PIN est exigé, le navigateur le demande une fois et s’en souvient pendant la durée de session définie dans Sécurité."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um PIN é exigido, o navegador o pede uma vez e o lembra pela duração da sessão definida em Segurança."
          }
        }
      }
    },
    "When on, opening the server address in a browser shows the GridStream web app. It uses the same port as the iPad app, and the change applies immediately.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, al abrir la dirección del servidor en un navegador aparece la app web de GridStream. Usa el mismo puerto que la app para iPad y el cambio se aplica de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée, ouvrir l’adresse du serveur dans un navigateur affiche l’app web GridStream. Elle utilise le même port que l’app iPad, et le changement s’applique immédiatement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, abrir o endereço do servidor em um navegador mostra o app web do GridStream. Ele usa a mesma porta do app para iPad, e a mudança vale imediatamente."
          }
        }
      }
    },
    "When something doesn't connect or show up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando algo no se conecta o no aparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelque chose ne se connecte pas ou n’apparaît pas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando algo não se conecta ou não aparece."
          }
        }
      }
    },
    "Where GridStream keeps its database, by default in Application Support. Show in Finder reveals the database file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde GridStream guarda su base de datos, de forma predeterminada en Application Support. Mostrar en el Finder muestra el archivo de la base de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emplacement de la base de données de GridStream, par défaut dans Application Support. Afficher dans le Finder montre le fichier de la base."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o GridStream guarda o banco de dados, por padrão em Application Support. Mostrar no Finder mostra o arquivo do banco de dados."
          }
        }
      }
    },
    "Where GridStream keeps its database: tags, ratings, lists, annotations, captures and scrub previews. Your video files are never moved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde GridStream guarda su base de datos: etiquetas, valoraciones, listas, anotaciones, capturas y vistas previas de desplazamiento. Tus archivos de vídeo nunca se mueven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emplacement de la base de données de GridStream : tags, notes, listes, annotations, captures et aperçus de défilement. Vos fichiers vidéo ne sont jamais déplacés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o GridStream guarda o banco de dados: etiquetas, classificações, listas, anotações, capturas e prévias de navegação. Seus arquivos de vídeo nunca são movidos."
          }
        }
      }
    },
    "While the server runs, the menu bar menu shows how many devices are connected and what they are playing; choose that line to open this pane. The menu bar icon changes while a video is playing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras el servidor está en ejecución, el menú de la barra de menús muestra cuántos dispositivos están conectados y qué reproducen; elige esa línea para abrir este panel. El icono de la barra de menús cambia mientras se reproduce un vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le serveur est en marche, le menu de la barre des menus indique combien d’appareils sont connectés et ce qu’ils lisent ; choisissez cette ligne pour ouvrir ce panneau. L’icône de la barre des menus change pendant la lecture d’une vidéo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o servidor está em execução, o menu da barra de menus mostra quantos dispositivos estão conectados e o que estão reproduzindo; escolha essa linha para abrir este painel. O ícone da barra de menus muda enquanto um vídeo é reproduzido."
          }
        }
      }
    },
    "Who can reach your library.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién puede acceder a tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui peut accéder à votre bibliothèque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem pode acessar sua biblioteca."
          }
        }
      }
    },
    "With a PIN, only iPads and browsers that know it can browse, stream or change your library. Without one, anyone on your network can. Leave it on unless your network is entirely yours.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un PIN, solo los iPad y navegadores que lo conocen pueden explorar, reproducir o cambiar tu biblioteca. Sin él, puede hacerlo cualquiera en tu red. Déjalo activado salvo que la red sea solo tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un code PIN, seuls les iPad et navigateurs qui le connaissent peuvent parcourir, lire ou modifier votre bibliothèque. Sans code PIN, n’importe qui sur votre réseau le peut. Laissez-le activé, sauf si votre réseau n’est utilisé que par vous."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um PIN, somente iPads e navegadores que o conhecem podem navegar, reproduzir ou alterar sua biblioteca. Sem ele, qualquer pessoa na sua rede pode. Deixe-o ativado, a menos que a rede seja só sua."
          }
        }
      }
    },
