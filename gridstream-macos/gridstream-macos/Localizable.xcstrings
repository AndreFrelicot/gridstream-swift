    "Browse and manage your library from any browser on your network. The web interface is served on the same port as the API used by the iPad.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora y gestiona tu biblioteca desde cualquier navegador de tu red. La interfaz web se sirve en el mismo puerto que la API que usa el iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez et gérez votre bibliothèque depuis n’importe quel navigateur de votre réseau. L’interface web est servie sur le même port que l’API utilisée par l’iPad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue e gerencie sua biblioteca em qualquer navegador da sua rede. A interface web é servida na mesma porta da API usada pelo iPad."
          }
        }
      }
    },
