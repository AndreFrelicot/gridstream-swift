    "PIN protection is off. Anyone on your network can browse, stream and change your library.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección con PIN está desactivada. Cualquiera en tu red puede explorar, reproducir y cambiar tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
