            "value": "Velocidade"
          }
        }
      }
    },
    "Too many wrong PINs, sign-in paused": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados PIN incorrectos, inicio de sesión en pausa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de codes PIN erronés, connexion suspendue"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos PINs incorretos, início de sessão pausado"
          }
        }
      }
    },
    "Troubleshooting": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solución de problemas"
          }
        },
        "fr": {
