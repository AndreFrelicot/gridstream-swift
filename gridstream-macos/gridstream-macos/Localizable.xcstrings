          }
        }
      }
    },
    "Reads every video again and regenerates its thumbnail. Slower; use it if thumbnails or durations look wrong.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a leer cada vídeo y regenera su miniatura. Es más lento; úsalo si las miniaturas o las duraciones parecen incorrectas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relit chaque vidéo et régénère sa vignette. Plus lent ; utilisez-le si des vignettes ou des durées semblent fausses."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê cada vídeo novamente e gera a miniatura de novo. É mais lento; use se miniaturas ou durações parecerem erradas."
          }
        }
      }
    },
