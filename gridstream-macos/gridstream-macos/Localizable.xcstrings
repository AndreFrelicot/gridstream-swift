    "1. Add your folders": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Añade tus carpetas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ajoutez vos dossiers"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Adicione suas pastas"
          }
        }
      }
    },
    "2. Keep the server running": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Mantén el servidor en ejecución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Laissez le serveur en marche"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Mantenha o servidor em execução"
          }
        }
      }
    },
    "3. Connect the iPad": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Conecta el iPad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Connectez l’iPad"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Conecte o iPad"
          }
        }
      }
    },
    "A folder on a disconnected drive is marked unavailable. Its videos are kept and come back when the drive is connected again and the folder is scanned.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta en un disco desconectado se marca como no disponible. Sus vídeos se conservan y vuelven cuando se reconecta el disco y se analiza la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier sur un disque déconnecté est marqué indisponible. Ses vidéos sont conservées et reviennent quand le disque est reconnecté et que le dossier est analysé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta em um disco desconectado é marcada como indisponível. Os vídeos dela são mantidos e voltam quando o disco é reconectado e a pasta é analisada."
          }
        }
      }
    },
    "A video is missing": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta un vídeo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vidéo manque"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um vídeo está faltando"
          }
        }
      }
    },
