            "value": "Stockage"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenamento"
          }
        }
      }
    },
    "Streaming your library on port %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmitiendo tu biblioteca en el puerto %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusion de votre bibliothèque sur le port %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmitindo sua biblioteca na porta %@"
          }
        }
      }
    },
    "The PIN may have changed or all sessions may have been revoked. Enter the PIN shown in Settings > Server, or set a new one in Security.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que el PIN haya cambiado o que se hayan revocado todas las sesiones. Introduce el PIN que aparece en Ajustes > Servidor o define uno nuevo en Seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code PIN a peut-être changé ou toutes les sessions ont pu être révoquées. Saisissez le code PIN affiché dans Réglages > Serveur, ou définissez-en un nouveau dans Sécurité."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PIN pode ter mudado ou todas as sessões podem ter sido revogadas. Digite o PIN mostrado em Ajustes > Servidor ou defina um novo em Segurança."
          }
        }
      }
    },
    "The PIN to enter on the iPad or in the browser. When GridStream generated it, it is shown here; if you set your own PIN, it is not shown.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PIN que hay que introducir en el iPad o en el navegador. Si lo generó GridStream, aparece aquí; si definiste tu propio PIN, no se muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code PIN à saisir sur l’iPad ou dans le navigateur. S’il a été généré par GridStream, il est affiché ici ; si vous avez défini votre propre code PIN, il n’est pas affiché."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PIN a ser digitado no iPad ou no navegador. Se foi gerado pelo GridStream, ele aparece aqui; se você definiu seu próprio PIN, ele não é mostrado."
          }
        }
      }
    },
    "The TCP port the server listens on, 8080 by default. Stop the server, type a port between 1024 and 65535, press Return, then start the server again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto TCP en el que escucha el servidor, 8080 de forma predeterminada. Detén el servidor, escribe un puerto entre 1024 y 65535, pulsa Retorno y vuelve a iniciar el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port TCP sur lequel le serveur écoute, 8080 par défaut. Arrêtez le serveur, saisissez un port compris entre 1024 et 65535, appuyez sur Retour, puis redémarrez le serveur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porta TCP em que o servidor escuta, 8080 por padrão. Pare o servidor, digite uma porta entre 1024 e 65535, pressione Return e inicie o servidor novamente."
          }
        }
      }
    },
    "The address other devices on your network use to reach this Mac, made of its local network name and the server port. Click the copy button to put it on the clipboard.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección que usan los demás dispositivos de tu red para llegar a este Mac, formada por su nombre en la red local y el puerto del servidor. Haz clic en el botón de copiar para ponerla en el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse que les autres appareils de votre réseau utilisent pour joindre ce Mac, composée de son nom sur le réseau local et du port du serveur. Cliquez sur le bouton de copie pour la placer dans le presse-papiers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço que outros dispositivos da sua rede usam para acessar este Mac, formado pelo nome dele na rede local e pela porta do servidor. Clique no botão de copiar para colocá-lo na área de transferência."
          }
        }
      }
    },
    "The database and scrub previews.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos y las vistas previas de desplazamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de données et les aperçus de défilement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados e as prévias de navegação."
          }
        }
      }
    },
    "The iPad doesn't find this Mac": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPad no encuentra este Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPad ne trouve pas ce Mac"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPad não encontra este Mac"
          }
        }
      }
    },
    "The iPad keeps asking for the PIN": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPad pide el PIN una y otra vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPad redemande sans cesse le code PIN"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPad continua pedindo o PIN"
          }
        }
      }
    },
    "The last %lld entries, newest first. The log is cleared when GridStream quits.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las últimas %lld entradas, las más recientes primero. El registro se borra al salir de GridStream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld dernières entrées, les plus récentes en premier. Le journal est vidé à la fermeture de GridStream."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As últimas %lld entradas, as mais recentes primeiro. O registro é apagado ao encerrar o GridStream."
          }
        }
      }
    },
    "The server doesn't start": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no se inicia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne démarre pas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não inicia"
          }
        }
      }
    },
    "The server is stopped.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor está detenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur est arrêté."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está parado."
          }
        }
      }
    },
    "The server is stopped. iPads and browsers cannot connect.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor está detenido. Los iPad y los navegadores no pueden conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur est arrêté. Les iPad et les navigateurs ne peuvent pas se connecter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está parado. iPads e navegadores não podem se conectar."
          }
        }
      }
    },
    "The server starts by itself when GridStream opens. Its status is shown at the top of the sidebar and in the menu bar menu.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor se inicia solo al abrir GridStream. Su estado aparece en la parte superior de la barra lateral y en el menú de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur démarre tout seul à l’ouverture de GridStream. Son état est affiché en haut de la barre latérale et dans le menu de la barre des menus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor é iniciado sozinho quando o GridStream é aberto. O estado dele aparece no topo da barra lateral e no menu da barra de menus."
          }
        }
      }
    },
    "The switch on the right of a folder hides its videos from clients without deleting anything. Turn it back on to find its videos again with their tags, ratings and other data.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interruptor a la derecha de una carpeta oculta sus vídeos a los clientes sin eliminar nada. Vuelve a activarlo para recuperar sus vídeos con sus etiquetas, valoraciones y otros datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interrupteur à droite d’un dossier masque ses vidéos aux clients sans rien supprimer. Réactivez-le pour retrouver ses vidéos avec leurs tags, notes et autres données."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave à direita de uma pasta oculta os vídeos dela dos clientes sem apagar nada. Ative-a novamente para recuperar os vídeos com suas etiquetas, classificações e outros dados."
          }
        }
      }
    },
    "The top of the menu shows whether the server is running and on which port, how many videos are in the catalog, and the PIN when GridStream generated it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte superior del menú indica si el servidor está en ejecución y en qué puerto, cuántos vídeos hay en el catálogo y el PIN si lo generó GridStream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le haut du menu indique si le serveur est en marche et sur quel port, combien de vidéos compte le catalogue, et le code PIN s’il a été généré par GridStream."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O topo do menu mostra se o servidor está em execução e em qual porta, quantos vídeos há no catálogo e o PIN, quando gerado pelo GridStream."
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac"
          }
        }
      }
    },
    "This build of GridStream does not include the web interface. Install Node.js and rebuild the app, or run scripts/build-web.sh before building.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación de GridStream no incluye la interfaz web. Instala Node.js y vuelve a compilar la app, o ejecuta scripts/build-web.sh antes de compilar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de GridStream n’inclut pas l’interface web. Installez Node.js et recompilez l’app, ou exécutez scripts/build-web.sh avant la compilation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação do GridStream não inclui a interface web. Instale o Node.js e compile o app novamente, ou execute scripts/build-web.sh antes de compilar."
          }
        }
      }
    },
    "This folder contains the source folder “%@”. Remove that folder first, or add a folder that does not overlap it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta contiene la carpeta de origen “%@”. Quita primero esa carpeta o añade una carpeta que no se solape con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier contient le dossier source « %@ ». Supprimez d’abord ce dossier, ou ajoutez un dossier qui ne le chevauche pas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta contém a pasta de origem “%@”. Remova essa pasta primeiro ou adicione uma pasta que não se sobreponha a ela."
          }
        }
      }
    },
    "This folder is already a source folder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta ya es una carpeta de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est déjà un dossier source."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta já é uma pasta de origem."
          }
        }
      }
    },
    "This folder is inside the source folder “%@”, which already includes its videos.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta está dentro de la carpeta de origen “%@”, que ya incluye sus vídeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier se trouve dans le dossier source « %@ », qui inclut déjà ses vidéos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta está dentro da pasta de origem “%@”, que já inclui os vídeos dela."
          }
        }
      }
    },
    "This will permanently delete all %lld cached scrub frames. This action cannot be undone.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This will permanently delete %lld cached scrub frame. This action cannot be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This will permanently delete all %lld cached scrub frames. This action cannot be undone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se eliminará de forma permanente %lld fotograma de desplazamiento. Esta acción no se puede deshacer."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se eliminarán de forma permanente los %lld fotogramas de desplazamiento. Esta acción no se puede deshacer."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld image de défilement sera définitivement supprimée. Cette action est irréversible."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les %lld images de défilement seront définitivement supprimées. Cette action est irréversible."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld quadro de navegação será apagado permanentemente. Esta ação não pode ser desfeita."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Todos os %lld quadros de navegação serão apagados permanentemente. Esta ação não pode ser desfeita."
                }
              }
            }
          }
        }
      }
    },
    "This will permanently delete all videos, thumbnails, tags, and ratings from the database. This action cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de forma permanente todos los vídeos, miniaturas, etiquetas y valoraciones de la base de datos. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les vidéos, vignettes, tags et notes seront définitivement supprimés de la base de données. Cette action est irréversible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os vídeos, miniaturas, etiquetas e classificações serão apagados permanentemente do banco de dados. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "Throughput": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidad"
          }
        },
        "fr": {
