    "No device is connected. Devices appear here when they use the server.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún dispositivo conectado. Los dispositivos aparecen aquí cuando usan el servidor."
          }
        },
        "fr": {
