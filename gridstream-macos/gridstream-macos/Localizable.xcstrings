    "Add a folder that contains your videos. They stay where they are; nothing is copied.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una carpeta que contenga tus vídeos. Se quedan donde están; no se copia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier qui contient vos vidéos. Elles restent où elles sont ; rien n’est copié."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma pasta que contenha seus vídeos. Eles ficam onde estão; nada é copiado."
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereço"
          }
        }
      }
    },
    "Adds a folder and its subfolders. GridStream serves .mp4, .m4v and .mov files. Adding a folder that is inside, or contains, a folder already in the list is refused.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una carpeta y sus subcarpetas. GridStream ofrece archivos .mp4, .m4v y .mov. No se puede añadir una carpeta que esté dentro de otra de la lista o que la contenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un dossier et ses sous-dossiers. GridStream diffuse les fichiers .mp4, .m4v et .mov. Un dossier situé dans un dossier déjà présent dans la liste, ou qui en contient un, est refusé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma pasta e suas subpastas. O GridStream oferece arquivos .mp4, .m4v e .mov. Uma pasta que esteja dentro de outra da lista, ou que contenha uma delas, é recusada."
          }
        }
      }
    },
    "All sessions revoked.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han revocado todas las sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les sessions ont été révoquées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as sessões foram revogadas."
          }
        }
      }
    },
    "Another app may be using the port. Choose another port in Settings > Server.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que otra app esté usando el puerto. Elige otro puerto en Ajustes > Servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app utilise peut-être le port. Choisissez un autre port dans Réglages > Serveur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app pode estar usando a porta. Escolha outra porta em Ajustes > Servidor."
          }
        }
      }
    },
