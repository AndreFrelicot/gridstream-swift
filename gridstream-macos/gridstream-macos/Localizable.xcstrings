            "value": "Manter a sessão por"
          }
        }
      }
    },
    "Stop Server": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter le serveur"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar servidor"
          }
        }
      }
    },
    "Stop the server to change its port.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén el servidor para cambiar su puerto."
          }
        },
        "fr": {
