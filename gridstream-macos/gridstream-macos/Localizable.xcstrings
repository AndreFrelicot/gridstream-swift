    "Frees the space used by scrub previews. They are generated again when needed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera el espacio que ocupan las vistas previas de desplazamiento. Se vuelven a generar cuando hacen falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère l’espace occupé par les aperçus de défilement. Ils sont générés de nouveau si nécessaire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera o espaço usado pelas prévias de navegação. Elas são geradas novamente quando necessário."
          }
        }
      }
    },
    "Generate scrub previews in the background": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generar las vistas previas de desplazamiento en segundo plano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générer les aperçus de défilement en arrière-plan"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerar as prévias de navegação em segundo plano"
          }
        }
      }
    },
    "Generated PIN": {
      "localizations": {
