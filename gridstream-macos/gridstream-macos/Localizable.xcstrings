            "state": "translated",
            "value": "Nenhum dispositivo conectado. Os dispositivos aparecem aqui quando usam o servidor."
          }
        }
      }
    },
    "No longer active, %@ sent": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inactivo, %@ enviados en total"
          }
        },
