        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconecta este iPad de um servidor que usa PIN. Você precisará do PIN novamente para se reconectar."
          }
        }
      }
    },
    "Silences every other video while it is on, without changing their own settings." : {
      "localizations" : {
        "es" : {
