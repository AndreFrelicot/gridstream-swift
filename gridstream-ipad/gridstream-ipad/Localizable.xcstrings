    },
    "Tap to show full video with letterboxing. Long press to apply to all tiles." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para mostrar el vídeo completo con bandas negras. Mantén pulsado para aplicarlo a todos los recuadros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour afficher la vidéo entière avec des bandes noires. Appui long pour appliquer à toutes les vignettes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para mostrar o vídeo inteiro com tarjas. Mantenha pressionado para aplicar a todos os quadros."
          }
        }
      }
    },
    "Tap to solo only this video while in fullscreen" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para oír solo este vídeo en pantalla completa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour mettre uniquement cette vidéo en solo en plein écran"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para deixar somente este vídeo em solo durante a tela cheia"
          }
        }
      }
    },
    "Tap to switch this video between fill and fit; press and hold to switch every tile." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para alternar este vídeo entre rellenar y ajustar; mantén pulsado para cambiar todos los recuadros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour basculer cette vidéo entre Remplir et Ajuster ; maintenez le doigt pour basculer toutes les vignettes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para alternar este vídeo entre preencher e ajustar; mantenha pressionado para alternar todos os quadros."
          }
        }
      }
    },
    "Text Contains/Search" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto contiene/búsqueda"
          }
