    "Recalls a saved preset: the number of tiles and what each tile plays. Reset All empties every tile." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupera un preajuste guardado: el número de recuadros y lo que reproduce cada uno. Restablecer todo vacía todos los recuadros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappelle un préréglage enregistré : le nombre de vignettes et ce que lit chaque vignette. Tout réinitialiser vide toutes les vignettes."
          }
        },
        "pt-BR" : {
