    "Shows all videos or the videos of one list. With a list shown, Apply gives it to a tile, so Random and Next pick from it there." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra todos los vídeos o los de una lista. Con una lista visible, Aplicar la asigna a un recuadro, para que Aleatorio y Siguiente elijan de ella en ese recuadro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche toutes les vidéos ou celles d’une liste. Quand une liste est affichée, Appliquer l’attribue à une vignette, pour qu’Aléatoire et Suivante y piochent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra todos os vídeos ou os vídeos de uma lista. Com uma lista exibida, Aplicar a atribui a um quadro, para que Aleatório e Próximo escolham a partir dela nesse quadro."
          }
        }
      }
    },
    "Shows this video fullscreen, with the other tiles as floating windows." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra este vídeo en pantalla completa, con los demás recuadros como ventanas flotantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche cette vidéo en plein écran, avec les autres vignettes en fenêtres flottantes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra este vídeo em tela cheia, com os outros quadros como janelas flutuantes."
          }
        }
      }
    },
    "Shuffle All" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
