    "Tag Name" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de la etiqueta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nom du tag"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome da etiqueta"
          }
        }
      }
    },
    "Tag names are case-insensitive and will be normalized to lowercase." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de etiqueta no distinguen entre mayúsculas y minúsculas y se convertirán a minúsculas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms de tags ne tiennent pas compte de la casse et seront convertis en minuscules."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes de etiquetas não diferenciam maiúsculas de minúsculas e serão convertidos para minúsculas."
          }
        }
      }
    },
    "Tags" : {
      "localizations" : {
        "es" : {
