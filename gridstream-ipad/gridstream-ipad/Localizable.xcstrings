    "Threshold" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbral"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limiar"
          }
        }
      }
    },
    "Threshold: %lld dB" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbral: %lld dB"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil : %lld dB"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limiar: %lld dB"
          }
        }
      }
    },
    "Threshold: Level above which compression begins. Ratio: Amount of compression (e.g., 4:1 means 4dB over threshold becomes 1dB). Attack/Release: How quickly compression engages/releases. Makeup Gain: Volume boost after compression." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbral: nivel a partir del cual empieza la compresión. Relación: cantidad de compresión (p. ej., 4:1 significa que 4 dB por encima del umbral se convierten en 1 dB). Ataque/Liberación: rapidez con la que la compresión se activa o se libera. Ganancia de compensación: aumento de volumen tras la compresión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil : niveau au-delà duquel la compression commence. Ratio : intensité de la compression (par ex., 4:1 signifie que 4 dB au-dessus du seuil deviennent 1 dB). Attaque/Relâchement : vitesse à laquelle la compression s’enclenche/se relâche. Gain de compensation : augmentation du volume après compression."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limiar: nível acima do qual a compressão começa. Proporção: quantidade de compressão (por exemplo, 4:1 significa que 4 dB acima do limiar viram 1 dB). Ataque/Liberação: rapidez com que a compressão entra/sai. Ganho de compensação: aumento de volume após a compressão."
          }
        }
      }
    },
