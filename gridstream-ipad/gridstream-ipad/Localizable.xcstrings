    "Drag a floating window to move it, pinch to resize it, and turn with two fingers to rotate it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra una ventana flotante para moverla, pellizca para cambiar su tamaño y gira dos dedos para rotarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une fenêtre flottante pour la déplacer, pincez pour la redimensionner et tournez avec deux doigts pour la faire pivoter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste uma janela flutuante para movê-la, use o gesto de pinça para redimensioná-la e gire-a com dois dedos."
          }
        }
      }
    },
    "Drag along the seek bar to scrub; a preview frame follows your finger. Let go to jump there." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra por la barra de reproducción para desplazarte; un fotograma de vista previa sigue a tu dedo. Suelta para saltar a ese punto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le doigt le long de la barre de lecture pour faire défiler ; une image d’aperçu suit votre doigt. Relâchez pour y aller."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste ao longo da barra de reprodução para percorrer; um quadro de prévia acompanha seu dedo. Solte para ir até lá."
          }
        }
      }
    },
    "Drag the bar to set this tile's volume. Settings are kept per tile, also after relaunching the app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la barra para ajustar el volumen de este recuadro. Los ajustes se guardan por recuadro, incluso tras volver a abrir la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la barre pour régler le volume de cette vignette. Les réglages sont conservés par vignette, même après la relance de l’app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a barra para definir o volume deste quadro. Os ajustes são mantidos por quadro, mesmo depois de reabrir o app."
          }
        }
      }
    },
    "Draw on frames and save stills." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja sobre los fotogramas y guarda imágenes fijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessinez sur les images et enregistrez des captures."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhe em quadros e salve imagens estáticas."
          }
        }
      }
    },
    "Each range shows as a coloured segment on the seek bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada intervalo aparece como un segmento de color en la barra de reproducción."
