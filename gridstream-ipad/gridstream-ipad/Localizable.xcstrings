          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para desativar a panorâmica estéreo"
          }
        }
      }
    },
    "Tap to enable stereo panning based on PiP tile positions" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
