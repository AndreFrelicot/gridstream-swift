    "Audio normalization helps prevent sudden volume spikes when multiple videos play simultaneously." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La normalización de audio ayuda a evitar subidas bruscas de volumen cuando se reproducen varios vídeos a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La normalisation audio évite les pics de volume soudains quand plusieurs vidéos sont lues en même temps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A normalização de áudio ajuda a evitar picos repentinos de volume quando vários vídeos são reproduzidos ao mesmo tempo."
          }
        }
      }
    },
