        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar asigna la lista a un recuadro, para que Aleatorio, Siguiente y la acción final elijan de ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquer attribue la liste à une vignette : Aléatoire, Suivante et l’action de fin y piochent alors."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar atribui a lista a um quadro, para que Aleatório, Próximo e a ação de fim escolham a partir dela."
          }
        }
      }
    },
    "Apply gives the list to a tile. The tile keeps its current video; Random, Next and the end action then pick from the list." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar asigna la lista a un recuadro. El recuadro conserva su vídeo actual; después, Aleatorio, Siguiente y la acción final eligen de la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquer attribue la liste à une vignette. La vignette garde sa vidéo actuelle ; Aléatoire, Suivante et l’action de fin piochent ensuite dans la liste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar atribui a lista a um quadro. O quadro mantém o vídeo atual; Aleatório, Próximo e a ação de fim passam a escolher a partir da lista."
          }
        }
      }
    },
