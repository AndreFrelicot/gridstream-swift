            "value" : "GridStream Server encontrado"
          }
        }
      }
    },
    "GridStream Server runs on the Mac that holds your videos and streams them to this iPad over your local network. Nothing is uploaded or copied." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GridStream Server se ejecuta en el Mac que contiene tus vídeos y los transmite a este iPad por tu red local. No se sube ni se copia nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GridStream Server s’exécute sur le Mac qui contient vos vidéos et les diffuse sur cet iPad via votre réseau local. Rien n’est envoyé ni copié."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GridStream Server é executado no Mac que contém seus vídeos e os transmite para este iPad pela sua rede local. Nada é enviado nem copiado."
          }
        }
      }
    },
    "GridStream Server runs on your Mac and shares your video folders with this iPad." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GridStream Server se ejecuta en tu Mac y comparte tus carpetas de vídeos con este iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GridStream Server s’exécute sur votre Mac et partage vos dossiers vidéo avec cet iPad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GridStream Server é executado no seu Mac e compartilha suas pastas de vídeos com este iPad."
          }
        }
      }
    },
