        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre los controles de volumen, silencio y solo de este recuadro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre les commandes de volume, de silence et de solo de cette vignette."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
