    "Play several videos together in one grid and keep an eye on all of them. Scrub frame by frame, rate, tag and annotate as they play." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce varios vídeos juntos en una cuadrícula sin perder de vista ninguno. Desplázate fotograma a fotograma, valora, etiqueta y anota mientras se reproducen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez plusieurs vidéos ensemble dans une même grille et gardez un œil sur chacune. Faites-les défiler image par image, notez-les, ajoutez des tags et des annotations pendant la lecture."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduza vários vídeos juntos em uma grade e acompanhe todos eles. Percorra quadro a quadro, classifique, adicione etiquetas e faça anotações enquanto eles são reproduzidos."
          }
        }
      }
    },
