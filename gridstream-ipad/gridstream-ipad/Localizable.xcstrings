    "Your videos are streamed, never uploaded or copied." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus vídeos se transmiten, nunca se suben ni se copian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos vidéos sont diffusées en streaming, jamais envoyées ni copiées."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus vídeos são transmitidos, nunca enviados nem copiados."
          }
        }
      }
    },
    "Remembers where the floating windows were for each video shown fullscreen. Press and hold to put them back in place, for this video or for all videos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda dónde estaban las ventanas flotantes para cada vídeo mostrado en pantalla completa. Mantén pulsado para devolverlas a su sitio, para este vídeo o para todos los vídeos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémorise la position des fenêtres flottantes pour chaque vidéo affichée en plein écran. Maintenez appuyé pour les remettre en place, pour cette vidéo ou pour toutes les vidéos."
          }
        },
        "pt-BR" : {
