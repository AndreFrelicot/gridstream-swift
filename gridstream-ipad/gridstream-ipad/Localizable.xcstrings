    "Swap a window" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambiar una ventana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échanger une fenêtre"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocar uma janela"
          }
        }
      }
    },
    "Swipe a list to rename it, change its order or delete it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza una lista para renombrarla, cambiar su orden o eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez une liste pour la renommer, modifier son ordre ou la supprimer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize uma lista para renomeá-la, alterar a ordenação ou apagá-la."
          }
        }
      }
    },
    "Swipe diagonally with two fingers toward a corner to slide the floating windows away; do it again to bring them back." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza en diagonal con dos dedos hacia una esquina para apartar las ventanas flotantes; repítelo para que vuelvan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez en diagonale avec deux doigts vers un coin pour écarter les fenêtres flottantes ; recommencez pour les faire revenir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize na diagonal com dois dedos em direção a um canto para afastar as janelas flutuantes; repita para trazê-las de volta."
          }
        }
      }
    },
    "Swipe for history" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza para ver el historial"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayer pour l’historique"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para ver o histórico"
          }
        }
      }
    },
    "Swipe it in the Presets tab." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslízalo en la pestaña Preajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez-le dans l’onglet Préréglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize-a na aba Predefinições."
          }
        }
      }
    },
    "Swipe right to go back to the video this tile played before. After going back, swipe left to go forward again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la derecha para volver al vídeo que este recuadro reproducía antes. Después de volver, desliza a la izquierda para avanzar de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la droite pour revenir à la vidéo que cette vignette lisait avant. Après être revenu en arrière, balayez vers la gauche pour avancer à nouveau."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a direita para voltar ao vídeo que este quadro reproduziu antes. Depois de voltar, deslize para a esquerda para avançar de novo."
          }
        }
      }
    },
    "Switch between horizontal and vertical layout orientation" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternar entre orientación horizontal y vertical de la disposición"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basculer entre l’orientation horizontale et verticale de la disposition"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternar entre orientação horizontal e vertical do layout"
          }
        }
      }
    },
    "Switches between filling the tile (cropping the edges) and fitting the whole picture." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna entre rellenar el recuadro (recortando los bordes) y ajustar la imagen completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bascule entre remplir la vignette (en rognant les bords) et ajuster l’image entière."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna entre preencher o quadro (cortando as bordas) e ajustar a imagem inteira."
          }
        }
      }
    },
    "Symmetric" : {
