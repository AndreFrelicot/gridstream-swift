    "Signs this iPad out of a server that uses a PIN. You will need the PIN again to reconnect." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la sesión de este iPad en un servidor que usa PIN. Necesitarás el PIN de nuevo para volver a conectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
