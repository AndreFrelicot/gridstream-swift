            "value" : "Toca para activar la panoramización estéreo según la posición de los recuadros PiP"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour activer le panoramique stéréo selon la position des fenêtres flottantes"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para ativar a panorâmica estéreo com base na posição dos quadros PiP"
          }
        }
      }
    },
    "Tap to fill the tile. Long press to apply to all tiles." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para rellenar el recuadro. Mantén pulsado para aplicarlo a todos los recuadros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour remplir la vignette. Appui long pour appliquer à toutes les vignettes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para preencher o quadro. Mantenha pressionado para aplicar a todos os quadros."
          }
        }
      }
    },
    "Tap to open audio controls" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para abrir los controles de audio"
