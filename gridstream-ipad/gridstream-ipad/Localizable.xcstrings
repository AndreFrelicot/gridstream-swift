    "Play or scrub to the start, tap Set Start, move to the end, then tap Set End to save the range." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce o desplázate hasta el inicio, toca Marcar inicio, ve hasta el final y toca Marcar final para guardar el intervalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez ou faites défiler jusqu’au début, touchez Définir le début, allez jusqu’à la fin, puis touchez Définir la fin pour enregistrer la plage."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduza ou percorra até o início, toque em Definir início, vá até o fim e toque em Definir fim para salvar o intervalo."
          }
        }
      }
    },
