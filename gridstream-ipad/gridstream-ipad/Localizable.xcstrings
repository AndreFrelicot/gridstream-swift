      }
    },
    "Tags Include" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetas incluidas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags inclus"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetas incluídas"
          }
        }
      }
    },
    "Tap a floating window to show it fullscreen; the fullscreen video takes its place." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una ventana flotante para verla en pantalla completa; el vídeo en pantalla completa ocupa su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une fenêtre flottante pour l’afficher en plein écran ; la vidéo en plein écran prend sa place."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma janela flutuante para exibi-la em tela cheia; o vídeo em tela cheia assume o lugar dela."
          }
        }
      }
    },
    "Tap a range to jump to its start and edit it, then use Update Start or Update End at the current position. The X deletes a range." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un intervalo para saltar a su inicio y editarlo; luego usa Actualizar inicio o Actualizar final en la posición actual. La X elimina un intervalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une plage pour aller à son début et la modifier, puis utilisez Mettre à jour le début ou Mettre à jour la fin à la position actuelle. Le X supprime une plage."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um intervalo para ir ao início dele e editá-lo; depois use Atualizar início ou Atualizar fim na posição atual. O X apaga um intervalo."
          }
        }
      }
    },
    "Tap a thumbnail to play it on the tile and close the library." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una miniatura para reproducirla en el recuadro y cerrar la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une miniature pour la lire dans la vignette et fermer la bibliothèque."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma miniatura para reproduzir o vídeo no quadro e fechar a biblioteca."
          }
        }
      }
    },
    "Tap a tile to select it: it gets a coloured border and plays at full volume, while the other tiles play quieter. Top bar actions apply to the selected tile." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un recuadro para seleccionarlo: se le añade un borde de color y se reproduce a pleno volumen, mientras los demás recuadros suenan más bajo. Las acciones de la barra superior se aplican al recuadro seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une vignette pour la sélectionner : elle reçoit une bordure colorée et est lue à plein volume, tandis que les autres vignettes sont lues plus doucement. Les actions de la barre supérieure s’appliquent à la vignette sélectionnée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um quadro para selecioná-lo: ele ganha uma borda colorida e é reproduzido com volume total, enquanto os outros quadros tocam mais baixo. As ações da barra superior se aplicam ao quadro selecionado."
          }
        }
      }
    },
    "Tap a video to show its controls; they hide after a few seconds. Double-tap to hide them at once." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un vídeo para mostrar sus controles; se ocultan tras unos segundos. Toca dos veces para ocultarlos al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une vidéo pour afficher ses commandes ; elles se masquent après quelques secondes. Touchez deux fois pour les masquer immédiatement."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um vídeo para mostrar os controles; eles se ocultam após alguns segundos. Toque duas vezes para ocultá-los imediatamente."
          }
        }
      }
    },
    "Tap and double-tap" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocar y tocar dos veces"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toucher et toucher deux fois"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocar e tocar duas vezes"
          }
        }
      }
    },
    "Tap any tile to show the bar. It hides by itself after a few seconds, and stays up while one of its menus is open." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cualquier recuadro para mostrar la barra. Se oculta sola tras unos segundos y permanece visible mientras uno de sus menús está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez n’importe quelle vignette pour afficher la barre. Elle se masque d’elle-même après quelques secondes et reste affichée tant qu’un de ses menus est ouvert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em qualquer quadro para mostrar a barra. Ela se oculta sozinha após alguns segundos e permanece visível enquanto um dos menus dela estiver aberto."
          }
        }
      }
    },
    "Tap the pencil next to the seek bar: the video pauses and you can draw on the frame with Apple Pencil. Drawings are saved with their frame and show only in annotation mode." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el lápiz junto a la barra de reproducción: el vídeo se pone en pausa y puedes dibujar sobre el fotograma con el Apple Pencil. Los dibujos se guardan con su fotograma y solo se muestran en el modo de anotación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le crayon à côté de la barre de lecture : la vidéo se met en pause et vous pouvez dessiner sur l’image avec l’Apple Pencil. Les dessins sont enregistrés avec leur image et ne s’affichent qu’en mode annotation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no lápis ao lado da barra de reprodução: o vídeo pausa e você pode desenhar no quadro com o Apple Pencil. Os desenhos são salvos com o respectivo quadro e só aparecem no modo de anotação."
          }
        }
      }
    },
    "Tap the rating on a tile to expand it, then tap a heart to rate from 1 to 10. Tap the current heart again to clear the rating." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la valoración de un recuadro para ampliarla y luego toca un corazón para valorar de 1 a 10. Vuelve a tocar el corazón actual para borrar la valoración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la note d’une vignette pour la développer, puis touchez un cœur pour noter de 1 à 10. Touchez à nouveau le cœur actuel pour effacer la note."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque na classificação de um quadro para expandi-la e toque em um coração para classificar de 1 a 10. Toque novamente no coração atual para limpar a classificação."
          }
        }
      }
    },
    "Tap the time ranges button next to the seek bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón de intervalos de tiempo junto a la barra de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton des plages temporelles à côté de la barre de lecture."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no botão de intervalos de tempo ao lado da barra de reprodução."
          }
        }
      }
    },
    "Tap to deactivate SuperSolo and restore previous audio states" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para desactivar SuperSolo y restaurar los estados de audio anteriores"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour désactiver SuperSolo et rétablir l’état audio précédent"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para desativar o SuperSolo e restaurar os estados de áudio anteriores"
          }
        }
      }
    },
    "Tap to disable stereo panning" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para desactivar la panoramización estéreo"
