          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O painel de classificação também mostra quantas vezes um vídeo foi reproduzido e por quanto tempo."
          }
        }
      }
    },
    "The seek bar, precision scrubbing and the end screen." : {
      "localizations" : {
        "es" : {
